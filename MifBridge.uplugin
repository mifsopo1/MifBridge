{
	"FileVersion": 3,
	"Version": 3,
	"VersionName": "0.3.0",
	"FriendlyName": "Mif Bridge",
	"Description": "Localhost HTTP bridge that lets an AI agent drive the Unreal Editor: Blueprint graphs, components, properties, materials, levels and assets over JSON (Claude/MCP). Ships alongside a shared MCP server that also fronts a Blender backend, so an agent can round-trip a mesh out of Unreal, edit it in Blender and reimport it.",
	"Category": "Editor",
	"CreatedBy": "Mif",
	"CreatedByURL": "https://github.com/mifsopo1/MifBridge",
	"DocsURL": "https://github.com/mifsopo1/MifBridge#readme",
	"SupportURL": "https://github.com/mifsopo1/MifBridge/issues",
	"CanContainContent": false,
	"IsBetaVersion": true,
	"Installed": false,
	"EnabledByDefault": true,
	"Modules": [
		{
			"Name": "MifBridge",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [
				"Win64"
			]
		}
	],
	"Plugins": [
		{
			"Name": "EnhancedInput",
			"Enabled": true
		}
	]
}