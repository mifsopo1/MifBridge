# The Unreal plugin is Windows-only: keep CRLF in the working tree for every text file so the
# editor, Visual Studio and GitHub Desktop all agree and nobody gets a whole-file diff from line
# endings.
#
# This now also applies to the cross-platform halves (tools/mcp-server, tools/blender-addon).
# That is deliberate and harmless: CPython and Blender both read CRLF sources fine, and one
# whole-repo rule beats a per-directory exception that someone forgets to extend.
* text=auto eol=crlf

# Explicit for the file types actually in this repo, so a new extension cannot slip through as LF.
*.cpp   text eol=crlf
*.h     text eol=crlf
*.cs    text eol=crlf
*.py    text eol=crlf
*.md    text eol=crlf
*.json  text eol=crlf
*.ini   text eol=crlf
*.uplugin text eol=crlf

*.txt   text eol=crlf
*.toml  text eol=crlf

# Binary — never touch these.
*.png   binary
*.uasset binary
*.umap  binary
*.pdb   binary
*.dll   binary
*.lib   binary
*.zip   binary
*.blend binary
*.fbx   binary
