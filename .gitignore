Binaries/
Intermediate/
Saved/
DerivedDataCache/
.vs/
*.sln
*.suo
*.sdf

# Python bytecode from the MCP layer (tools/mcp-server) and the Blender addon
# (tools/blender-addon) — a .pyc was committed once already; it is build output
# and must never be tracked.
__pycache__/
*.pyc

# Blender addon build output (tools/blender-addon/build_zip.py) and Blender's
# rolling backups. The addon SOURCE under tools/blender-addon/MifBlender/ is
# tracked — only the packaged artifact and .blend backups are not.
tools/blender-addon/dist/
*.blend1
*.blend2
tools/audit_findings.jsonl
tools/fuzz_run*.log

# scratch dumps produced while auditing the MIF_BIND registry
Source/MifBridge/Private/bound_tmp.txt
tools/audit_findings.pre-night-sweep.jsonl

# run_all_suites.py writes a fresh log per invocation. suite_results.json IS tracked - it is the
# structured result the next run compares against - but the raw console logs are regenerated every
# time and only ever differ by timing noise.
tools/suite_run_*.log
